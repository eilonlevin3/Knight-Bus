rules_version = '2';
// Each user can read and write only their own favorites. Docs: docs/data-model.md#favorite
// "favorites" is used by the main app, "favoritesDebug" by the debug app (docs/release-process.md),
// so testing never touches real favorites.
// Deploy with:  npx firebase-tools deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{collection}/{slot} {
      allow read, delete: if request.auth != null && request.auth.uid == uid
        && collection in ['favorites', 'favoritesDebug'];
      allow write: if request.auth != null && request.auth.uid == uid
        && collection in ['favorites', 'favoritesDebug']
        && slot in ['1', '2', '3']
        && request.resource.data.keys().hasOnly(['name', 'cityId', 'stops', 'origin', 'destination', 'updatedAt'])
        && request.resource.data.stops is list
        && request.resource.data.stops.size() >= 1
        && request.resource.data.stops.size() <= 2;
    }
    // Detailed usage events of the DEBUG version only (docs/privacy.md). Each person can add
    // to, read and delete their own; nobody can edit an event after it is written.
    match /users/{uid}/debugEvents/{id} {
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'channel', 'at', 'detail'])
        && request.resource.data.channel != 'main';
      allow read, delete: if request.auth != null && request.auth.uid == uid;
    }
  }
}
