rules_version = '2';
// Each user can read and write only their own favorites. Docs: docs/data-model.md#favorite
// Deploy with:  npx firebase-tools deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/favorites/{slot} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid
        && slot in ['1', '2', '3']
        && request.resource.data.keys().hasOnly(['name', 'cityId', 'stops', 'updatedAt'])
        && request.resource.data.stops is list
        && request.resource.data.stops.size() >= 1
        && request.resource.data.stops.size() <= 2;
    }
  }
}
